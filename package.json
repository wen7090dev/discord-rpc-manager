{
    "name": "discord-rpc-manager",
    "version": "1.0.2",
    "description": "Custom Discord Rich Presence Manager",
    "author": {
        "name": "wen7090dev",
        "email": "wen7090dev@gmail.com"
    },
    "license": "Custom-NC-AP",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build && electron-builder",
        "preview": "vite preview",
        "electron:dev": "node kill-port.cjs && concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development node launch-electron.cjs\""
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "discord-rpc": "^4.0.1",
        "electron-updater": "^6.3.9",
        "framer-motion": "^11.2.10",
        "lucide-react": "^0.395.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.3.0",
        "zustand": "^4.5.2"
    },
    "devDependencies": {
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "concurrently": "^8.2.2",
        "cross-env": "^10.1.0",
        "electron": "^31.0.1",
        "electron-builder": "^26.8.1",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.4",
        "vite": "^5.3.1",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.wen7090.discordrpc",
        "productName": "Discord RPC Manager",
        "copyright": "Copyright © 2026 wen7090dev",
        "publish": [
            {
                "provider": "github",
                "owner": "wen7090dev",
                "repo": "discord-rpc-manager"
            }
        ],
        "directories": {
            "output": "dist_electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "LICENSE",
                "to": "LICENSE.txt"
            }
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "public/logo.png",
            "artifactName": "${productName}-${arch}.${ext}"
        },
        "nsis": {
            "artifactName": "Discord-RPC-Manager-Setup.exe",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "shortcutName": "Discord RPC Manager",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "include": "build/installer.nsh",
            "installerLanguages": [
                "en_US",
                "fr_FR",
                "es_ES",
                "de_DE"
            ]
        },
        "portable": {
            "artifactName": "Discord-RPC-Manager-Portable.exe"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "public/logo.png",
            "category": "public.app-category.utilities",
            "artifactName": "Discord-RPC-Manager-mac-${arch}.${ext}"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "public/logo.png",
            "category": "Utility",
            "artifactName": "Discord-RPC-Manager-linux.${ext}"
        }
    }
}
